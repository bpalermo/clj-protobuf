load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_clj//clojure:defs.bzl", "clj_library", "clj_test")

package(default_visibility = ["//visibility:public"])

# The vendored fixtures under fixtures/ are the emitter's output for the protos
# under //test/proto, byte for byte — the contract, not hand-written code.
#
#   bazel test //test:update_fixtures_tests  fail if they drift from the pinned
#                                            protoc_gen_clojure's output
#   bazel run  //test:update_fixtures        accept the drift, then review it
#
# Keyed on the paths //test/proto's generation targets declare, so a proto
# added there without a vendored fixture fails at analysis, not silently.
write_source_files(
    name = "update_fixtures",
    files = {
        "fixtures/fixtures/bench/shapes.clj": "//test/proto:fixtures/bench/shapes.clj",
        "fixtures/fixtures/bench_nohint/shapes.clj": "//test/proto:fixtures/bench_nohint/shapes.clj",
        "fixtures/fixtures/e2023/kitchen.clj": "//test/proto:fixtures/e2023/kitchen.clj",
        "fixtures/fixtures/e2024/kitchen.clj": "//test/proto:fixtures/e2024/kitchen.clj",
        "fixtures/fixtures/e2024legacy/legacy_style.clj": "//test/proto:fixtures/e2024legacy/legacy_style.clj",
        "fixtures/fixtures/nested/nested.clj": "//test/proto:fixtures/nested/nested.clj",
        "fixtures/fixtures/p2/kitchen.clj": "//test/proto:fixtures/p2/kitchen.clj",
        "fixtures/fixtures/p3/kitchen.clj": "//test/proto:fixtures/p3/kitchen.clj",
        "fixtures/fixtures/wire/e2024.clj": "//test/proto:fixtures/wire/e2024.clj",
        "fixtures/fixtures/wire/p2.clj": "//test/proto:fixtures/wire/p2.clj",
        "fixtures/fixtures/wire/p3.clj": "//test/proto:fixtures/wire/p3.clj",
        "fixtures/interop/fixtures/bench/shapes.clj": "//test/proto:interop/fixtures/bench/shapes.clj",
        "fixtures/interop/fixtures/e2024/kitchen.clj": "//test/proto:interop/fixtures/e2024/kitchen.clj",
        "fixtures/interop/fixtures/wire/e2024.clj": "//test/proto:interop/fixtures/wire/e2024.clj",
        "fixtures/interop/fixtures/wire/p2.clj": "//test/proto:interop/fixtures/wire/p2.clj",
        "fixtures/interop/fixtures/wire/p3.clj": "//test/proto:interop/fixtures/wire/p3.clj",
    },
)

# The generated fixtures: real protoc-gen-clojure output (codec_ns and
# runtime_ns at their clj-protobuf defaults), kept current by the drift test
# above.
clj_library(
    name = "fixtures",
    srcs = glob(
        ["fixtures/**/*.clj"],
        exclude = ["fixtures/fixtures/bench_nohint/**"],
    ),
    direct_linking = "on",
    namespaces = [
        "fixtures.p2.kitchen",
        "fixtures.p3.kitchen",
        "fixtures.e2023.kitchen",
        "fixtures.e2024.kitchen",
        "fixtures.e2024legacy.legacy-style",
        "fixtures.nested.nested",
        "fixtures.bench.shapes",
        "fixtures.wire.p2",
        "fixtures.wire.p3",
        "fixtures.wire.e2024",
    ],
    strip_prefix = "test/fixtures",
    deps = [
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# The benchmark's DynamicMessage arm: the same shapes regenerated with Java
# class hints that cannot resolve (com.acme.absent.nohint.*), so the hint
# fallback engages no matter what is on the classpath.
clj_library(
    name = "fixtures_nohint",
    srcs = ["fixtures/fixtures/bench_nohint/shapes.clj"],
    direct_linking = "on",
    namespaces = ["fixtures.bench-nohint.shapes"],
    strip_prefix = "test/fixtures",
    deps = [
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# interop=true output (ns_prefix=interop keeps them apart from the standard
# fixtures): the fast typed arm, validated here because this repo owns the
# behavioral tests of emitted code.
clj_library(
    name = "fixtures_interop",
    srcs = glob(["fixtures/interop/**/*.clj"]),
    namespaces = [
        "interop.fixtures.e2024.kitchen",
        "interop.fixtures.bench.shapes",
        "interop.fixtures.wire.p2",
        "interop.fixtures.wire.p3",
        "interop.fixtures.wire.e2024",
    ],
    strip_prefix = "test/fixtures",
    deps = [
        "//src:clj_protobuf",
        # The fast arm's classes are a load-time requirement — the documented
        # interop=true contract.
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# The interop fixtures uncompiled, for the reflection gate below: require
# :reload needs .clj sources to recompile under *warn-on-reflection*, and an
# AOT jar's classes would be loaded as they are.
clj_library(
    name = "fixtures_interop_source",
    srcs = glob(["fixtures/interop/**/*.clj"]),
    aot = False,
    namespaces = [
        "interop.fixtures.e2024.kitchen",
        "interop.fixtures.bench.shapes",
        "interop.fixtures.wire.p2",
        "interop.fixtures.wire.p3",
        "interop.fixtures.wire.e2024",
    ],
    strip_prefix = "test/fixtures",
    deps = [
        "//src:clj_protobuf",
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_library(
    name = "contract_test_lib",
    srcs = ["clj_protobuf/contract_test.clj"],
    namespaces = ["clj-protobuf.contract-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "contract_test",
    ns = "clj-protobuf.contract-test",
    deps = [":contract_test_lib"],
)

# The generated Java classes are IN this target's classpath, which flips the
# goldens' class hints on: fixture prototypes here are generated instances, so
# this suite covers the hinted arm and rebuilds the DynamicMessage arm by hand.
# contract_test, which has no Java fixture dep, is the pure-DynamicMessage arm
# of the same goldens.
clj_library(
    name = "byte_identity_test_lib",
    srcs = ["clj_protobuf/byte_identity_test.clj"],
    namespaces = ["clj-protobuf.byte-identity-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "byte_identity_test",
    ns = "clj-protobuf.byte-identity-test",
    deps = [":byte_identity_test_lib"],
)

clj_library(
    name = "invoker_test_lib",
    srcs = ["clj_protobuf/invoker_test.clj"],
    namespaces = ["clj-protobuf.invoker-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "invoker_test",
    ns = "clj-protobuf.invoker-test",
    deps = [":invoker_test_lib"],
)

clj_library(
    name = "interop_test_lib",
    srcs = ["clj_protobuf/interop_test.clj"],
    namespaces = ["clj-protobuf.interop-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        ":fixtures_interop",
        "//src:clj_protobuf",
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "interop_test",
    ns = "clj-protobuf.interop-test",
    deps = [":interop_test_lib"],
)

clj_library(
    name = "errors_test_lib",
    srcs = ["clj_protobuf/errors_test.clj"],
    namespaces = ["clj-protobuf.errors-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "errors_test",
    ns = "clj-protobuf.errors-test",
    deps = [":errors_test_lib"],
)

# The wire layer, primitive by primitive, against protobuf-java on the same
# bytes: our writer's bytes parse as DynamicMessage's value, DynamicMessage's
# bytes read back through our reader, sizes agree with lengths. Needs no
# generated Java classes, so it runs on the plain-clj leg too.
clj_library(
    name = "wire_test_lib",
    srcs = ["clj_protobuf/wire_test.clj"],
    namespaces = ["clj-protobuf.wire-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "wire_test",
    ns = "clj-protobuf.wire-test",
    deps = [":wire_test_lib"],
)

# The codec compiler: its tables, checked on the wire fixtures, and its parse
# and write loops against DynamicMessage on the same bytes. Plain-clj too.
clj_library(
    name = "compile_test_lib",
    srcs = ["clj_protobuf/compile_test.clj"],
    namespaces = ["clj-protobuf.compile-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "compile_test",
    ns = "clj-protobuf.compile-test",
    deps = [":compile_test_lib"],
)

# The compiled message against DynamicMessage: bytes, equality, hashing,
# TextFormat, the reflective API both ways, merge semantics, every parser
# overload, initialization, and grpc-java's marshaller call pattern.
clj_library(
    name = "message_test_lib",
    srcs = ["clj_protobuf/message_test.clj"],
    namespaces = ["clj-protobuf.message-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "message_test",
    ns = "clj-protobuf.message-test",
    deps = [":message_test_lib"],
)

# The equivalence harness: every arm of the runtime — hinted, DynamicMessage,
# and the compiled codec once it exists — must produce protoc's bytes and read
# the same values, over the wire corpus in //test/proto/fixtures/wire and over
# values drawn from the descriptors themselves. Needs the generated Java
# classes: the hinted arm is the reference.
clj_library(
    name = "equivalence_test_lib",
    srcs = ["clj_protobuf/equivalence_test.clj"],
    namespaces = ["clj-protobuf.equivalence-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
        "@deps//:org_clojure_test_check",
    ],
)

clj_test(
    name = "equivalence_test",
    ns = "clj-protobuf.equivalence-test",
    deps = [":equivalence_test_lib"],
)

# interop=true output is direct typed calls by definition; a reflective one is
# a plugin bug this repo is the only place equipped to catch (protoc's classes
# and the runtime are both on this classpath, and neither is on the plugin's).
clj_library(
    name = "interop_reflection_test_lib",
    srcs = ["clj_protobuf/interop_reflection_test.clj"],
    namespaces = ["clj-protobuf.interop-reflection-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures_interop_source",
        "//src:clj_protobuf",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "interop_reflection_test",
    ns = "clj-protobuf.interop-reflection-test",
    deps = [":interop_reflection_test_lib"],
)

# Depends on the SOURCE variant so require :reload-all has .clj files to
# recompile under *warn-on-reflection*.
clj_library(
    name = "reflection_test_lib",
    srcs = ["clj_protobuf/reflection_test.clj"],
    namespaces = ["clj-protobuf.reflection-test"],
    strip_prefix = "test",
    deps = [
        "//src:clj_protobuf_source",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "reflection_test",
    ns = "clj-protobuf.reflection-test",
    deps = [":reflection_test_lib"],
)
