load("@rules_clj//clojure:defs.bzl", "clj_library", "clj_test")

package(default_visibility = ["//visibility:public"])

# The generated fixtures: real protoc-gen-clojure output, regenerated with
# codec_ns=clj-protobuf.codec,runtime_ns=clj-protobuf.runtime. The .proto
# sources they came from live under //test/proto. Regenerate with the plugin
# whenever those change — these files are the contract, not hand-written code.
clj_library(
    name = "fixtures",
    srcs = glob(
        ["fixtures/**/*.clj"],
        exclude = ["fixtures/fixtures/bench_nohint/**"],
    ),
    namespaces = [
        "fixtures.p2.kitchen",
        "fixtures.p3.kitchen",
        "fixtures.e2023.kitchen",
        "fixtures.e2024.kitchen",
        "fixtures.e2024legacy.legacy-style",
        "fixtures.nested.nested",
        "fixtures.bench.shapes",
    ],
    strip_prefix = "test/fixtures",
    deps = [
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# The benchmark's DynamicMessage arm: the same shapes regenerated with Java
# class hints that cannot resolve (com.acme.absent.nohint.*), so the hint
# fallback engages no matter what is on the classpath.
clj_library(
    name = "fixtures_nohint",
    srcs = ["fixtures/fixtures/bench_nohint/shapes.clj"],
    namespaces = ["fixtures.bench-nohint.shapes"],
    strip_prefix = "test/fixtures",
    deps = [
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_library(
    name = "contract_test_lib",
    srcs = ["clj_protobuf/contract_test.clj"],
    namespaces = ["clj-protobuf.contract-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "contract_test",
    ns = "clj-protobuf.contract-test",
    deps = [":contract_test_lib"],
)

# The generated Java classes are IN this target's classpath, which flips the
# goldens' class hints on: fixture prototypes here are generated instances, so
# this suite covers the hinted arm and rebuilds the DynamicMessage arm by hand.
# contract_test, which has no Java fixture dep, is the pure-DynamicMessage arm
# of the same goldens.
clj_library(
    name = "byte_identity_test_lib",
    srcs = ["clj_protobuf/byte_identity_test.clj"],
    namespaces = ["clj-protobuf.byte-identity-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "byte_identity_test",
    ns = "clj-protobuf.byte-identity-test",
    deps = [":byte_identity_test_lib"],
)

clj_library(
    name = "invoker_test_lib",
    srcs = ["clj_protobuf/invoker_test.clj"],
    namespaces = ["clj-protobuf.invoker-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "invoker_test",
    ns = "clj-protobuf.invoker-test",
    deps = [":invoker_test_lib"],
)

clj_library(
    name = "errors_test_lib",
    srcs = ["clj_protobuf/errors_test.clj"],
    namespaces = ["clj-protobuf.errors-test"],
    strip_prefix = "test",
    deps = [
        ":fixtures",
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "errors_test",
    ns = "clj-protobuf.errors-test",
    deps = [":errors_test_lib"],
)

# Depends on the SOURCE variant so require :reload-all has .clj files to
# recompile under *warn-on-reflection*.
clj_library(
    name = "reflection_test_lib",
    srcs = ["clj_protobuf/reflection_test.clj"],
    namespaces = ["clj-protobuf.reflection-test"],
    strip_prefix = "test",
    deps = [
        "//src:clj_protobuf_source",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "reflection_test",
    ns = "clj-protobuf.reflection-test",
    deps = [":reflection_test_lib"],
)
