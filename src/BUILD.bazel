load("@rules_clj//clojure:defs.bzl", "clj_library", "clj_maven_export")

package(default_visibility = ["//visibility:public"])

# The whole library, compat aliases included, as one target: the namespaces are
# a single dependency chain (naming <- runtime <- codec <- core <- aliases) and
# the published jar ships them together anyway. Namespace order is compile
# order.
clj_library(
    name = "clj_protobuf",
    srcs = glob([
        "clj_protobuf/**/*.clj",
        "clj_grpc/**/*.clj",
    ]),
    namespaces = [
        "clj-protobuf.impl.naming",
        "clj-protobuf.impl.invoke",
        "clj-protobuf.runtime",
        "clj-protobuf.codec",
        "clj-protobuf.core",
        "clj-grpc.runtime",
        "clj-grpc.codec",
    ],
    strip_prefix = "src",
    deps = [
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# The same namespaces as sources, uncompiled — what the published Clojars jar
# actually ships, and what the reflection gate recompiles with
# *warn-on-reflection* bound so a reflective hot path fails the build.
clj_library(
    name = "clj_protobuf_source",
    srcs = glob([
        "clj_protobuf/**/*.clj",
        "clj_grpc/**/*.clj",
    ]),
    aot = False,
    namespaces = [
        "clj-protobuf.impl.naming",
        "clj-protobuf.impl.invoke",
        "clj-protobuf.runtime",
        "clj-protobuf.codec",
        "clj-protobuf.core",
        "clj-grpc.runtime",
        "clj-grpc.codec",
    ],
    strip_prefix = "src",
    deps = [
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# The Clojars artifact: the same sources the jar above ships, plus a pom derived
# from the deps.edn and the version.edn that everything else here reads. What
# used to be build.clj, a :build alias and tools.build.
#
#   bazel build //src:clojars                    the jar and the pom
#   bazel run //src:clojars.publish -- --dry-run every PUT, nothing sent
#   bazel run //src:clojars.publish              the upload
#
# Here rather than in the root package because a glob cannot cross into a
# subpackage, and these sources live in this one.
clj_maven_export(
    name = "clojars",
    srcs = glob([
        "clj_protobuf/**/*.clj",
        "clj_grpc/**/*.clj",
    ]),
    artifact_id = "clj-protobuf",
    deps_edn = "//:deps.edn",
    description = "Protobuf runtime for code generated by protoc-gen-clojure: records in, protoc's bytes out. Editions through 2024.",
    group_id = "com.github.bpalermo",
    license = (
        "Apache-2.0",
        "https://www.apache.org/licenses/LICENSE-2.0",
    ),
    scm_url = "https://github.com/bpalermo/clj-protobuf",
    strip_prefix = "src",
    url = "https://github.com/bpalermo/clj-protobuf",
    version_file = "//:version.edn",
)
