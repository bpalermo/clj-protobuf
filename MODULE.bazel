# clj-protobuf — the protobuf runtime for code generated by protoc-gen-clojure.
#
# This module is the Bazel-side build of a library whose consumers arrive via
# Clojars (com.github.bpalermo/clj-protobuf), not via a registry: nothing here
# is published to BCR. Bazel is the whole harness: build, test, and — since
# rules_clj 0.2.0 — the jar, the pom and the Clojars upload (//src:clojars).
module(
    name = "clj_protobuf",
    version = "0.1.5",
)

# The ruleset, from the Bazel Central Registry.
bazel_dep(name = "rules_clj", version = "0.2.0")

# Dependencies come from deps.edn, resolved once into the committed lockfile by
# rules_clj's //tools/lock, fetched by digest at build time.
deps = use_extension("@rules_clj//clojure:extensions.bzl", "deps")
deps.install(
    name = "deps",
    lock = "//:deps.lock.json",
)
use_repo(deps, "deps")

# For the byte-identity fixtures: proto_library + java_proto_library over the
# same protos the goldens were generated from, so the reference bytes come from
# protoc's own Java backend. Same version protobuf-java is pinned at in
# deps.edn — the descriptors must agree.
bazel_dep(name = "protobuf", version = "35.1", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# Solely for the sh_test wrapping the version-consistency check.
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
