# clj-protobuf — the protobuf runtime for code generated by protoc-gen-clojure.
#
# This module is the Bazel-side build of a library whose consumers arrive via
# Clojars (com.github.bpalermo/clj-protobuf), not via a registry: nothing here
# is published to BCR. Bazel is the whole harness: build, test, and — since
# rules_clj 0.2.0 — the jar, the pom and the Clojars upload (//src:clojars).
module(
    name = "clj_protobuf",
    version = "0.1.5",
)

# The ruleset, from the Bazel Central Registry. 0.2.4 brings direct linking:
# clj_library(direct_linking = "on") compiles var calls as static calls. On
# here for the library and the fixture targets — measured ~10-18% on decode
# of small and nested shapes — and deliberately not on the bench library
# (jsonista, criterium and data.json ship as source, which a linked target
# may not call into: rules_clj refuses the build) nor on the aot = False
# source variant the reflection gate recompiles. Note that this only speeds
# THIS repo's tests and bench: the Clojars jar is source-only, so what a
# consumer gets depends on the consumer's build or on
# -Dclojure.compiler.direct-linking=true at runtime.
bazel_dep(name = "rules_clj", version = "0.2.4")

# Dependencies come from deps.edn, resolved once into the committed lockfile by
# rules_clj's //tools/lock, fetched by digest at build time.
deps = use_extension("@rules_clj//clojure:extensions.bzl", "deps")
deps.install(
    name = "deps",
    lock = "//:deps.lock.json",
)
use_repo(deps, "deps")

# For the byte-identity fixtures: proto_library + java_proto_library over the
# same protos the goldens were generated from, so the reference bytes come from
# protoc's own Java backend. Same version protobuf-java is pinned at in
# deps.edn — the descriptors must agree, and java_proto_library puts this
# module's own runtime on the test classpath next to the Maven jar, so a
# mismatch would mean two protobuf-java versions in one JVM.
#
# 36.1.bcr.1 and not 36.1: from 36.x protobuf prefers its prebuilt protoc by
# default, and the 36.1 module shipped an empty integrity table for it, so
# every proto action failed to fetch. The BCR patch release carries the table.
bazel_dep(name = "protobuf", version = "36.1.bcr.1", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# Solely for the sh_test wrapping the version-consistency check.
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

# The emitter, for regenerating the vendored fixtures under test/fixtures. They
# stay checked in — the plain-clj CI leg reads them from disk, pull requests
# show emitter changes as diffs, and old emissions are backward-compatibility
# coverage — but //test:update_fixtures_test fails when they drift from what
# this pinned version emits, and `bazel run //test:update_fixtures` rewrites
# them. Bumping this version is the one step of a fixture refresh.
bazel_dep(name = "protoc_gen_clojure", version = "0.5.1", dev_dependency = True)

plugin = use_extension(
    "@protoc_gen_clojure//clojure:extensions.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(plugin, "protoc_gen_clojure_toolchains")

register_toolchains(
    "@protoc_gen_clojure_toolchains//:all",
    dev_dependency = True,
)

# write_source_files: the drift test plus the run target that accepts it.
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)
