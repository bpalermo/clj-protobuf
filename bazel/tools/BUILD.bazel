load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Every declared or documented version must equal version.edn's. //src:clojars
# reads version.edn as an action input, the release workflow compares it against
# the tag;
# the README snippet is the one copy nothing else checks — which is exactly the
# class of miss that shipped stale install docs in protoc-gen-clojure 0.3.1.
sh_test(
    name = "version_consistency_test",
    srcs = ["version_consistency_test.sh"],
    args = [
        "$(rootpath //:version.edn)",
        "$(rootpath //:README.md)",
    ],
    data = [
        "//:README.md",
        "//:version.edn",
    ],
)

# The lockfile is resolved offline by rules_clj's //tools/lock and committed;
# a build never re-resolves it, so a dependency added to deps.edn without a
# relock is simply invisible. MODULE.bazel.lock has --config=strict-lockfile
# for the same class of mistake; this is the deps.edn half.
sh_test(
    name = "deps_lock_consistency_test",
    srcs = ["deps_lock_consistency_test.sh"],
    args = [
        "$(rootpath //:deps.edn)",
        "$(rootpath //:deps.lock.json)",
    ],
    data = [
        "//:deps.edn",
        "//:deps.lock.json",
    ],
)
