load("@rules_clj//clojure:defs.bzl", "clj_binary", "clj_library", "clj_test")

package(default_visibility = ["//visibility:public"])

clj_library(
    name = "bench_lib",
    srcs = ["clj_protobuf/bench.clj"],
    namespaces = ["clj-protobuf.bench"],
    strip_prefix = "bench",
    deps = [
        "//src:clj_protobuf",
        "//test:fixtures",
        "//test:fixtures_interop",
        "//test:fixtures_nohint",
        # On the classpath so the hinted fixtures' class hints resolve, and for
        # the raw protobuf-java arm.
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:criterium_criterium",
        "@deps//:metosin_jsonista",
        "@deps//:org_clojure_clojure",
        "@deps//:org_clojure_data_json",
    ],
)

# manual: a benchmark in //... would make every CI run pay minutes of
# criterium. The smoke test below keeps this code compiling and its arms
# producing agreeing output on every bazel test //... instead.
clj_binary(
    name = "run",
    main = "clj-protobuf.bench",
    tags = ["manual"],
    deps = [":bench_lib"],
)

# The thread-scaling probe. manual for the same reason //bench:run is, and
# deliberately not a test: a scaling assertion on a loaded CI machine is a
# flake generator. What keeps it honest is that smoke_test_lib depends on it,
# so it compiles on every bazel test //... and cannot rot.
clj_library(
    name = "contention_lib",
    srcs = ["clj_protobuf/contention.clj"],
    namespaces = ["clj-protobuf.contention"],
    strip_prefix = "bench",
    deps = [
        "//src:clj_protobuf",
        "//test:fixtures",
        "//test:fixtures_nohint",
        "//test/proto:fixtures_java_proto",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_binary(
    name = "contention",
    main = "clj-protobuf.contention",
    tags = ["manual"],
    deps = [":contention_lib"],
)

clj_library(
    name = "smoke_test_lib",
    srcs = ["clj_protobuf/bench_smoke_test.clj"],
    namespaces = ["clj-protobuf.bench-smoke-test"],
    strip_prefix = "bench",
    deps = [
        ":bench_lib",
        ":contention_lib",
        "//src:clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "smoke_test",
    ns = "clj-protobuf.bench-smoke-test",
    deps = [":smoke_test_lib"],
)
